generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model ContactModel {
  id          String   @id
  username    String   @unique
  displayName String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  conversations ConversationModel[]

  @@map("contacts")
}

model ConversationModel {
  id                     String    @id
  contactId              String
  platform               String    @default("TIKTOK")
  streakDays             Int       @default(0)
  streakLastInteractionAt DateTime  @default(now())
  isStreakActive         Boolean   @default(false)
  lastMessageSentAt      DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  contact  ContactModel   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  messages MessageModel[]

  @@index([contactId])
  @@index([isStreakActive, lastMessageSentAt])
  @@map("conversations")
}

model MessageModel {
  id             String    @id
  conversationId String
  type           String
  content        String
  status         String    @default("PENDING")
  sentAt         DateTime?
  errorMessage   String?
  createdAt      DateTime  @default(now())

  conversation ConversationModel @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([conversationId, sentAt])
  @@index([conversationId, type])
  @@map("messages")
}
