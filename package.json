{
  "type": "module",
  "imports": {
    "#domain/*": "./dist/src/domain/*",
    "#automation/*": "./dist/src/automation/*",
    "#engine/*": "./dist/src/engine/*",
    "#database/*": "./dist/src/database/*",
    "#scheduler/*": "./dist/src/scheduler/*",
    "#config/*": "./dist/src/config/*",
    "#types/*": "./dist/src/types/*",
    "#utils/*": "./dist/src/utils/*",
    "#*": "./dist/src/*"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc",
    "start": "node dist/src/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "node --require ./eslint-loader.cjs ./node_modules/eslint/bin/eslint.js .",
    "lint:fix": "node --require ./eslint-loader.cjs ./node_modules/eslint/bin/eslint.js . --fix",
    "format": "prettier --write .",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "playwright:install": "playwright install chromium"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "@typescript/typescript6": "^6.0.2",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "express": "^5.2.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.65.0"
  },
  "dependencies": {
    "@prisma/client": "^7.9.1",
    "dotenv": "^17.4.2",
    "node-cron": "^4.6.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "playwright": "^1.62.0",
    "prisma": "^7.9.1",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  }
}
