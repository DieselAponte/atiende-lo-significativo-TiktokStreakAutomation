{
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./dist",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2024",
    "lib": [
      "ES2024"
    ],
    "types": [
      "node"
    ],
    "strict": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "paths": {
      "#domain/*": [
        "./src/domain/*"
      ],
      "#automation/*": [
        "./src/automation/*"
      ],
      "#engine/*": [
        "./src/engine/*"
      ],
      "#database/*": [
        "./src/database/*"
      ],
      "#scheduler/*": [
        "./src/scheduler/*"
      ],
      "#config/*": [
        "./src/config/*"
      ],
      "#types/*": [
        "./src/types/*"
      ],
      "#utils/*": [
        "./src/utils/*"
      ],
      "#*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "src/**/*",
    "src/database/prisma/prisma.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}